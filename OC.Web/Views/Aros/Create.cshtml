@model OC.Core.Domain.Entities.Aro
@{
    ViewData["Title"] = "Nuevo Aro";
    var maxImagenes = ViewBag.MaxImagenes as int? ?? 7;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card-dashboard animate-on-scroll" data-delay="0">
                <h4 class="mb-4"><i class="bi bi-eyeglasses me-2"></i> Nuevo Aro</h4>

                <form asp-action="Create" method="post" enctype="multipart/form-data" id="formCrearAro">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold">Nombre *</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Aro metálico rectangular" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SKU" class="form-label fw-semibold">SKU *</label>
                            <input asp-for="SKU" class="form-control" placeholder="Ej: ARO-001" />
                            <span asp-validation-for="SKU" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label fw-semibold">Precio (₡) *</label>
                            <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stock" class="form-label fw-semibold">Stock inicial *</label>
                            <input asp-for="Stock" type="number" min="0" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="MostrarEnLanding" id="MostrarEnLandingCreate" />
                                <label class="form-check-label fw-semibold" for="MostrarEnLandingCreate">
                                    <i class="bi bi-shop me-1"></i> Mostrar en el landing (sección "Lentes Graduados")
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DescripcionCorta" class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1"></i> Descripción corta
                            <small class="text-muted fw-normal">(opcional — aparece en el landing)</small>
                        </label>
                        <textarea asp-for="DescripcionCorta" class="form-control" rows="2" maxlength="500"
                                  placeholder="Resumen breve que verá el cliente en el carrusel del landing..."></textarea>
                        <span asp-validation-for="DescripcionCorta" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Imágenes del aro
                            <span class="badge bg-secondary" id="imagenesCounter">0 / @maxImagenes</span>
                        </label>

                        <div id="dropZone" class="drop-zone d-flex flex-column align-items-center justify-content-center text-center"
                             tabindex="0" role="button" aria-label="Arrastrá imágenes o hacé click para elegir">
                            <i class="bi bi-cloud-arrow-up-fill" style="font-size: 2.5rem; color: var(--color-brand);"></i>
                            <p class="mb-1 fw-semibold mt-2">Arrastrá imágenes acá</p>
                            <p class="text-muted small mb-0">o hacé click para elegir archivos</p>
                            <p class="text-muted small mb-0 mt-2">
                                Hasta <strong>@maxImagenes</strong> imágenes · JPG, PNG, GIF, WEBP · Máx 5 MB c/u
                            </p>
                            <input type="file" name="imagenesAro" id="imagenesInput" class="d-none"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" multiple />
                        </div>

                        <div id="imagenesToasts" class="mt-2"></div>
                        <div id="imagenesPreview" class="d-flex flex-wrap gap-2 mt-3"></div>
                        <span id="imagenesError" class="text-danger"></span>
                    </div>

                    <div class="form-footer-actions">
                        <div class="btn-group" role="group">
                            <button type="submit" class="btn btn-brand">
                                <i class="bi bi-check-lg me-2"></i> Guardar aro
                            </button>
                            <a asp-controller="Inventory" asp-action="Index" asp-route-seccion="aros" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-2"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .drop-zone {
            border: 2px dashed var(--color-border);
            border-radius: 12px;
            padding: 32px 16px;
            background: rgba(59, 130, 246, 0.03);
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s, transform 0.15s;
            min-height: 160px;
        }
        .drop-zone:hover { border-color: var(--color-brand); background: rgba(59, 130, 246, 0.08); }
        .drop-zone:focus { outline: none; border-color: var(--color-brand); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2); }
        .drop-zone.drag-over { border-color: var(--color-success); background: rgba(16, 185, 129, 0.12); transform: scale(1.01); }
        .preview-card {
            width: 110px; height: 130px; position: relative; border-radius: 10px; overflow: hidden;
            cursor: grab; border: 2px solid var(--color-border); background: #f8f9fa;
            transition: border-color 0.15s, transform 0.15s;
        }
        .preview-card:hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(0,0,0,0.12); }
        .preview-card.es-principal { border-color: var(--color-warning); border-width: 3px; }
        .preview-card img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
        .preview-card .grip { position: absolute; top: 4px; right: 4px; color: rgba(255,255,255,0.85); background: rgba(0,0,0,0.4); border-radius: 4px; padding: 0 4px; font-size: 0.85rem; z-index: 3; }
        .preview-card .badge-principal { position: absolute; top: 4px; left: 4px; background: var(--color-warning); color: #1e293b; font-size: 0.65rem; font-weight: 600; padding: 2px 6px; border-radius: 4px; z-index: 3; }
        .preview-card .badge-orden { position: absolute; bottom: 4px; right: 4px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; z-index: 3; }
        .preview-card .btn-quitar { position: absolute; top: 4px; left: 4px; background: rgba(220, 53, 69, 0.95); color: white; border: none; border-radius: 50%; width: 22px; height: 22px; font-size: 0.75rem; line-height: 1; cursor: pointer; z-index: 4; opacity: 0; transition: opacity 0.15s; }
        .preview-card:hover .btn-quitar { opacity: 1; }
        .sortable-ghost-preview { opacity: 0.4; background: rgba(245, 158, 11, 0.2); border: 2px dashed var(--color-warning) !important; }
        .sortable-chosen-preview { cursor: grabbing !important; }
        .img-toast { padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 6px; display: flex; align-items: center; gap: 8px; animation: slideDown 0.25s ease-out; }
        .img-toast-error { background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #b91c1c; }
        .img-toast-warning { background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); color: #92400e; }
        @@keyframes slideDown { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        $(function () {
            const maxImagenes = @maxImagenes;
            const extensionesValidas = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
            const maxBytes = 5 * 1024 * 1024;

            const dropZone = document.getElementById('dropZone');
            const input = document.getElementById('imagenesInput');
            const preview = document.getElementById('imagenesPreview');
            const counter = document.getElementById('imagenesCounter');
            const toastsBox = document.getElementById('imagenesToasts');

            let selectedFiles = [];

            dropZone.addEventListener('click', function () { input.click(); });
            dropZone.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
            });
            ['dragenter', 'dragover'].forEach(function (evt) {
                dropZone.addEventListener(evt, function (e) {
                    e.preventDefault(); e.stopPropagation();
                    dropZone.classList.add('drag-over');
                });
            });
            ['dragleave', 'dragend', 'drop'].forEach(function (evt) {
                dropZone.addEventListener(evt, function (e) {
                    e.preventDefault(); e.stopPropagation();
                    dropZone.classList.remove('drag-over');
                });
            });
            dropZone.addEventListener('drop', function (e) {
                addFiles(Array.from(e.dataTransfer.files || []));
            });
            input.addEventListener('change', function () {
                addFiles(Array.from(this.files || []));
                input.value = '';
            });

            function addFiles(files) {
                clearToasts();
                let ignorados = [];
                let agregados = 0;

                for (const file of files) {
                    const ext = '.' + (file.name.split('.').pop() || '').toLowerCase();
                    if (!extensionesValidas.includes(ext)) {
                        ignorados.push(`"${file.name}" no es una imagen válida`);
                        continue;
                    }
                    if (file.size > maxBytes) {
                        ignorados.push(`"${file.name}" excede 5 MB`);
                        continue;
                    }
                    if (selectedFiles.length >= maxImagenes) {
                        ignorados.push(`"${file.name}" (tope ${maxImagenes} alcanzado)`);
                        continue;
                    }
                    selectedFiles.push(file);
                    agregados++;
                }

                if (files.length > agregados && ignorados.length > 0) {
                    showToast(ignorados.join('. '), ignorados.length === files.length ? 'error' : 'warning');
                }

                renderPreview();
            }

            function renderPreview() {
                preview.innerHTML = '';
                selectedFiles.forEach(function (file, i) {
                    const card = document.createElement('div');
                    card.className = 'preview-card sortable-preview-item' + (i === 0 ? ' es-principal' : '');
                    card.setAttribute('data-original-index', i);
                    card.setAttribute('data-current-index', i);

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        card.innerHTML = `
                            <img src="${e.target.result}" alt="preview ${i + 1}" />
                            <span class="grip"><i class="bi bi-grip-vertical"></i></span>
                            ${i === 0 ? '<span class="badge-principal"><i class="bi bi-star-fill"></i> Principal</span>' : ''}
                            <span class="badge-orden">#${i + 1}</span>
                            <button type="button" class="btn-quitar" data-current-index="${i}" title="Quitar"><i class="bi bi-x"></i></button>
                        `;
                        card.querySelector('.btn-quitar').addEventListener('click', function (ev) {
                            ev.stopPropagation();
                            const idx = parseInt(this.getAttribute('data-current-index'), 10);
                            selectedFiles.splice(idx, 1);
                            renderPreview();
                        });
                    };
                    reader.readAsDataURL(file);
                    preview.appendChild(card);
                });

                if (selectedFiles.length === 0) {
                    counter.textContent = `0 / ${maxImagenes}`;
                    counter.className = 'badge bg-secondary';
                } else if (selectedFiles.length >= maxImagenes) {
                    counter.textContent = `${selectedFiles.length} / ${maxImagenes} (completo)`;
                    counter.className = 'badge bg-success';
                } else {
                    counter.textContent = `${selectedFiles.length} / ${maxImagenes}`;
                    counter.className = 'badge bg-secondary';
                }

                if (typeof Sortable !== 'undefined') {
                    if (preview._sortable) preview._sortable.destroy();
                    preview._sortable = Sortable.create(preview, {
                        animation: 180,
                        ghostClass: 'sortable-ghost-preview',
                        chosenClass: 'sortable-chosen-preview',
                        dragClass: 'sortable-drag',
                        onEnd: function () {
                            const newOrder = [];
                            const itemsEnOrden = [];
                            preview.querySelectorAll('.sortable-preview-item').forEach(function (item) {
                                const originalIdx = parseInt(item.getAttribute('data-original-index'), 10);
                                newOrder.push(selectedFiles[originalIdx]);
                                itemsEnOrden.push(item);
                            });
                            selectedFiles = newOrder;

                            itemsEnOrden.forEach(function (item, newIdx) {
                                const badge = item.querySelector('.badge-orden');
                                if (badge) badge.textContent = '#' + (newIdx + 1);

                                const btnQuitar = item.querySelector('.btn-quitar');
                                if (btnQuitar) btnQuitar.setAttribute('data-current-index', newIdx);

                                item.setAttribute('data-current-index', newIdx);

                                if (newIdx === 0) {
                                    item.classList.add('es-principal');
                                    if (!item.querySelector('.badge-principal')) {
                                        const bp = document.createElement('span');
                                        bp.className = 'badge-principal';
                                        bp.innerHTML = '<i class="bi bi-star-fill"></i> Principal';
                                        item.insertBefore(bp, item.firstChild);
                                    }
                                } else {
                                    item.classList.remove('es-principal');
                                    const bp = item.querySelector('.badge-principal');
                                    if (bp) bp.remove();
                                }
                            });
                        }
                    });
                }
            }

            function showToast(msg, tipo) {
                const div = document.createElement('div');
                div.className = 'img-toast img-toast-' + tipo;
                const icon = tipo === 'error' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill';
                div.innerHTML = `<i class="bi ${icon}"></i><span>${msg}</span>`;
                toastsBox.appendChild(div);
                setTimeout(function () {
                    div.style.transition = 'opacity 0.3s';
                    div.style.opacity = '0';
                    setTimeout(function () { div.remove(); }, 300);
                }, 6000);
            }

            function clearToasts() { toastsBox.innerHTML = ''; }

            document.getElementById('formCrearAro').addEventListener('submit', function (e) {
                if (selectedFiles.length === 0) return;
                try {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(function (f) { dt.items.add(f); });
                    input.files = dt.files;
                } catch (err) {
                    e.preventDefault();
                    showToast('Tu navegador no soporta drag-and-drop para envío. Usá el botón de selección.', 'error');
                }
            });
        });
    </script>
}
