@model OC.Core.Common.PagedResult<OC.Core.Domain.Entities.Producto>
@{
    ViewData["Title"] ="Inventario";
    var seccion = ViewBag.Seccion as string ??"productos";
    var paginationProductos = ViewBag.PaginationProductos as PaginationInfo;
    var paginationTecnologias = ViewBag.PaginationTecnologias as PaginationInfo;
    var paginationAros = ViewBag.PaginationAros as PaginationInfo;
    var pagination = paginationProductos ?? new PaginationInfo
    {
        CurrentPage = Model.PageIndex,
        TotalPages = Model.TotalPages,
        GetPageUrl = (page) => Url.Action("Index", new { seccion, page, pageSize = ViewBag.PageSize })
    };
    var lowStock = ViewBag.LowStock as IEnumerable<OC.Core.Domain.Entities.Producto> ?? new List<OC.Core.Domain.Entities.Producto>();
    var tecnologias = ViewBag.Tecnologias as IEnumerable<OC.Core.Domain.Entities.TecnologiaLente> ?? new List<OC.Core.Domain.Entities.TecnologiaLente>();
    var aros = ViewBag.Aros as IEnumerable<OC.Core.Domain.Entities.Aro> ?? new List<OC.Core.Domain.Entities.Aro>();
}

<div class="container-fluid px-4">
    <div class="page-header animate-fade-up">
        <div class="page-header-text">
            <div class="page-header-icon"><i class="bi bi-box-seam"></i></div>
            <div>
                <h1 class="page-title">Inventario</h1>
                <p class="page-subtitle">
                    <i class="bi bi-info-circle me-1"></i>
                    Productos, tecnologías de lente y aros.
                </p>
            </div>
        </div>
        <div class="page-actions">
            <div class="dropdown">
                <button type="button" class="btn btn-brand dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-plus-circle me-2"></i> Agregar
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Create" asp-route-seccion="productos">
                        <i class="bi bi-box-seam me-2"></i> Producto
                    </a></li>
                    <li><a class="dropdown-item" asp-controller="Tecnologias" asp-action="Create">
                        <i class="bi bi-eyedropper me-2"></i> Tecnología de lente
                    </a></li>
                    <li><a class="dropdown-item" asp-controller="Aros" asp-action="Create">
                        <i class="bi bi-eyeglasses me-2"></i> Aro
                    </a></li>
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show animate-fade-up mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Tabs (sin Bootstrap JS, funcionan como links normales) ── *@
    <ul class="nav nav-tabs mb-0" id="inventarioTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold @(seccion =="productos" ?"active" :"")"
               href="@Url.Action("Index", new { seccion ="productos", page = 1, pageSize = 12 })">
                <i class="bi bi-box-seam me-1"></i> Productos
            </a>
        </li>
        <li class="nav-item">
                    <a class="nav-link text-dark fw-semibold @(seccion =="tecnologias" ? "active" : "")"
                       href="@Url.Action("Index", new { seccion = "tecnologias", tecPage = 1, tecPageSize = 12 })">
                        <i class="bi bi-eyedropper me-1"></i> Tecnologías
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark fw-semibold @(seccion =="aros" ? "active" : "")"
                       href="@Url.Action("Index", new { seccion = "aros", aroPage = 1, aroPageSize = 12 })">
                        <i class="bi bi-eyeglasses me-1"></i> Aros
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark fw-semibold @(seccion == "landing" ? "active" : "")"
                       href="@Url.Action("Index", new { seccion = "landing" })">
                        <i class="bi bi-collection-play-fill me-1"></i> Landing
                    </a>
                </li>
            </ul>

    <style>
        #inventarioTabs .nav-link {
            color: #6c757d;
            border-radius: 0;
        }
        #inventarioTabs .nav-link.active {
            color: #212529 !important;
            border-bottom: 3px solid #212529;
            background: transparent;
        }
        #inventarioTabs .nav-link:hover {
            color: #343a40;
        }
        .rpt-filter-icon { background: linear-gradient(135deg, #3b82f6, #2563eb); border-color: #3b82f6; color: white; }
        .rpt-filter-btn { background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; color: white; }
        .rpt-filter-btn:hover { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; }
        #inventarioTabs .nav-link i { color: inherit; }
        #inventarioTabs .nav-link.active i { color: #212529; }
    </style>

    <div class="tab-content" id="inventarioTabContent">
        @* ── PRODUCTOS ── *@
        <div class="tab-pane fade @(seccion =="productos" ?"show active" :"")" id="panel-productos" role="tabpanel">
            <div class="card-dashboard mt-0">
                <div class="card-header bg-white py-2">
                    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="hidden" name="seccion" value="productos" />
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 12)" />
                        <input type="hidden" name="filtroTecnologia" value="@ViewBag.FiltroTecnologia" />
                        <input type="hidden" name="filtroAro" value="@ViewBag.FiltroAro" />
                        <div class="input-group input-group-sm" style="max-width:300px">
                            <span class="input-group-text rpt-filter-icon"><i class="bi bi-search"></i></span>
                            <input type="text" name="filtroProducto" class="form-control"
                                   value="@ViewBag.FiltroProducto" placeholder="Buscar nombre, SKU..." />
                        </div>
                        <button type="submit" class="btn btn-sm rpt-filter-btn">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.FiltroProducto))
                        {
                            <a asp-action="Index" asp-route-seccion="productos" asp-route-page="1" asp-route-pageSize="@(Model?.PageSize ?? 12)"
                               asp-route-filtroTecnologia="@ViewBag.FiltroTecnologia" asp-route-filtroAro="@ViewBag.FiltroAro"
                               class="btn btn-sm btn-link text-decoration-none text-muted">
                                <i class="bi bi-x-circle"></i> Limpiar
                            </a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Items.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-box-seam text-muted" style="font-size:3rem"></i>
                            <p class="text-muted mt-3">No hay productos registrados.</p>
                            <a asp-controller="Inventory" asp-action="Create" class="btn btn-brand">
                                <i class="bi bi-plus-circle me-2"></i>Agregar primer producto
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:72px">Imagen</th>
                                        <th>Nombre</th>
                                        <th>SKU</th>
                                        <th>Costo unitario</th>
                                        <th>Stock</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        var stockClass = item.Stock < 6 ?"text-danger fw-bold" :"";
                                        <tr>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(item.RutaImagen))
                                                {
                                                    <img src="@item.RutaImagen" alt="" class="rounded border" style="height:48px;width:48px;object-fit:contain" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td>@item.Nombre</td>
                                            <td>@item.SKU</td>
                                            <td>₡@item.CostoUnitario.ToString("N2")</td>
                                            <td class="@stockClass">@item.Stock</td>
                                            <td>
                                                @if (item.Activo)
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-toolbar table-row-toolbar justify-content-center flex-wrap mb-0">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">
                                                            <i class="bi bi-eye"></i><span class="d-none d-xl-inline ms-1">Ver</span>
                                                        </a>
                                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                                            <i class="bi bi-pencil"></i><span class="d-none d-xl-inline ms-1">Editar</span>
                                                        </a>
                                                    </div>
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="ms-1"
                                                          onsubmit="return confirm('¿Eliminar este producto del catálogo?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash"></i><span class="d-none d-xl-inline ms-1">Eliminar</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @await Html.PartialAsync("_Pagination", pagination)

            @if (lowStock.Any())
            {
                <div class="card-dashboard mt-4 border-danger">
                    <div class="card-header bg-danger bg-opacity-10 border-bottom-0">
                        <h5 class="mb-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Bajo stock (≤5)</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-danger mb-0">
                            <thead>
                                <tr><th style="width:56px"></th><th>Nombre</th><th>SKU</th><th>Stock</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in lowStock)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.RutaImagen))
                                            {
                                                <img src="@item.RutaImagen" alt="" class="rounded" style="height:40px;width:40px;object-fit:contain" />
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td>@item.Nombre</td>
                                        <td>@item.SKU</td>
                                        <td class="fw-bold text-danger">@item.Stock</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        @* ── TECNOLOGIAS ── *@
        <div class="tab-pane fade @(seccion =="tecnologias" ?"show active" :"")" id="panel-tecnologias" role="tabpanel">
            <div class="card-dashboard mt-0">
                <div class="card-header bg-white py-2">
                    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="hidden" name="seccion" value="tecnologias" />
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 12)" />
                        <input type="hidden" name="filtroProducto" value="@ViewBag.FiltroProducto" />
                        <input type="hidden" name="filtroAro" value="@ViewBag.FiltroAro" />
                        <div class="input-group input-group-sm" style="max-width:300px">
                            <span class="input-group-text rpt-filter-icon"><i class="bi bi-search"></i></span>
                            <input type="text" name="filtroTecnologia" class="form-control"
                                   value="@ViewBag.FiltroTecnologia" placeholder="Buscar nombre, SKU..." />
                        </div>
                        <button type="submit" class="btn btn-sm rpt-filter-btn">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.FiltroTecnologia))
                        {
                            <a asp-action="Index" asp-route-seccion="tecnologias" asp-route-page="1" asp-route-pageSize="@(Model?.PageSize ?? 12)"
                               class="btn btn-sm btn-link text-decoration-none text-muted">
                                <i class="bi bi-x-circle"></i> Limpiar
                            </a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (!tecnologias.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-eyedropper text-muted" style="font-size:3rem"></i>
                            <p class="text-muted mt-3">No hay tecnologías registradas.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Nombre</th><th>Precio</th><th class="text-center">Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in tecnologias)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td>₡@item.Precio.ToString("N2")</td>
                                        <td class="text-center">
                                            <div class="btn-toolbar table-row-toolbar justify-content-center flex-wrap mb-0">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-controller="Tecnologias" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">
                                                        <i class="bi bi-eye"></i><span class="d-none d-xl-inline ms-1">Ver</span>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-secondary"
                                                            onclick="editarTecnologia(@item.Id, '@item.Nombre', @item.Precio.ToString("F2"))">
                                                        <i class="bi bi-pencil"></i><span class="d-none d-xl-inline ms-1">Editar</span>
                                                    </button>
                                                </div>
                                                <form asp-controller="Tecnologias" asp-action="Delete" asp-route-id="@item.Id" method="post" class="ms-1"
                                                      onsubmit="return confirm('¿Eliminar esta tecnología?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i><span class="d-none d-xl-inline ms-1">Eliminar</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
            @if (paginationTecnologias != null && paginationTecnologias.TotalPages > 1)
            {
                @await Html.PartialAsync("_Pagination", paginationTecnologias)
            }
        </div>

        @* ── AROS ── *@
        <div class="tab-pane fade @(seccion =="aros" ?"show active" :"")" id="panel-aros" role="tabpanel">
            <div class="card-dashboard mt-0">
                <div class="card-header bg-white py-2">
                    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="hidden" name="seccion" value="aros" />
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 12)" />
                        <input type="hidden" name="filtroProducto" value="@ViewBag.FiltroProducto" />
                        <input type="hidden" name="filtroTecnologia" value="@ViewBag.FiltroTecnologia" />
                        <div class="input-group input-group-sm" style="max-width:300px">
                            <span class="input-group-text rpt-filter-icon"><i class="bi bi-search"></i></span>
                            <input type="text" name="filtroAro" class="form-control"
                                   value="@ViewBag.FiltroAro" placeholder="Buscar nombre, SKU..." />
                        </div>
                        <button type="submit" class="btn btn-sm rpt-filter-btn">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.FiltroAro))
                        {
                            <a asp-action="Index" asp-route-seccion="aros" asp-route-page="1" asp-route-pageSize="@(Model?.PageSize ?? 12)"
                               class="btn btn-sm btn-link text-decoration-none text-muted">
                                <i class="bi bi-x-circle"></i> Limpiar
                            </a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (!aros.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-eyeglasses text-muted" style="font-size:3rem"></i>
                            <p class="text-muted mt-3">No hay aros registrados.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th style="width:64px">Imagen</th><th>Nombre</th><th>SKU</th><th>Precio</th><th>Stock</th><th>Estado</th><th class="text-center">Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in aros)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.RutaImagen))
                                            {
                                                <img src="@item.RutaImagen" alt="" class="rounded border" style="height:48px;width:48px;object-fit:contain" />
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td>@item.Nombre</td>
                                        <td>@item.SKU</td>
                                        <td>₡@item.Precio.ToString("N2")</td>
                                        <td class="@(item.Stock < 6 ?"text-danger fw-bold" :"")">@item.Stock</td>
                                        <td>
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-toolbar table-row-toolbar justify-content-center flex-wrap mb-0">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-controller="Aros" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">
                                                        <i class="bi bi-eye"></i><span class="d-none d-xl-inline ms-1">Ver</span>
                                                    </a>
                                                    <a asp-controller="Aros" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                                        <i class="bi bi-pencil"></i><span class="d-none d-xl-inline ms-1">Editar</span>
                                                    </a>
                                                </div>
                                                <form asp-controller="Aros" asp-action="Delete" asp-route-id="@item.Id" method="post" class="ms-1"
                                                      onsubmit="return confirm('¿Desactivar este aro?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i><span class="d-none d-xl-inline ms-1">Desactivar</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
            @if (paginationAros != null && paginationAros.TotalPages > 1)
            {
                @await Html.PartialAsync("_Pagination", paginationAros)
            }
        </div>

        @* ── LANDING ── *@
        @if (seccion == "landing")
        {
            var carruselItems = ViewBag.CarruselItems as List<OC.Core.Domain.Entities.LandingItemCarrusel> ?? new List<OC.Core.Domain.Entities.LandingItemCarrusel>();
            var destacadosItems = ViewBag.DestacadosItems as List<OC.Core.Domain.Entities.LandingItemDestacado> ?? new List<OC.Core.Domain.Entities.LandingItemDestacado>();
            var dispProductos = ViewBag.DisponiblesProductos as List<OC.Core.Domain.Entities.Producto> ?? new List<OC.Core.Domain.Entities.Producto>();
            var dispAros = ViewBag.DisponiblesAros as List<OC.Core.Domain.Entities.Aro> ?? new List<OC.Core.Domain.Entities.Aro>();
            var todosProductos = ViewBag.TodosProductos as List<OC.Core.Domain.Entities.Producto> ?? new List<OC.Core.Domain.Entities.Producto>();
            var todosAros = ViewBag.TodosAros as List<OC.Core.Domain.Entities.Aro> ?? new List<OC.Core.Domain.Entities.Aro>();

            string ImgProd(int id, string? legacy)
            {
                var p = todosProductos.FirstOrDefault(x => x.Id == id);
                return p?.RutaImagen ?? legacy ?? "/images/default-product.jpg";
            }
            string ImgAro(int id, string? legacy)
            {
                var a = todosAros.FirstOrDefault(x => x.Id == id);
                return a?.RutaImagen ?? legacy ?? "/images/default-product.jpg";
            }

            <div class="tab-pane fade @(seccion == "landing" ? "show active" : "")" id="panel-landing" role="tabpanel">
                <div class="card-dashboard mt-0">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="mb-0">
                                <i class="bi bi-collection-play-fill me-2 text-primary"></i>
                                Gestión del landing público
                            </h5>
                            <small class="text-muted">Arrastrá los items entre las zonas para controlar qué aparece en el carrusel (6) y en destacados (8).</small>
                        </div>
                        <div>
                            <span class="badge bg-primary me-2"><i class="bi bi-images me-1"></i> Carrusel: <span id="carruselCount">@carruselItems.Count</span>/6</span>
                            <span class="badge bg-info"><i class="bi bi-stars me-1"></i> Destacados: <span id="destacadosCount">@destacadosItems.Count</span>/8</span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        @* ────── CARRUSEL (6 slots fijos) ────── *@
                        <h6 class="mb-3 fw-bold">
                            <i class="bi bi-images me-1 text-primary"></i> Carrusel principal
                            <small class="text-muted fw-normal">(máx 6, orden de aparición = orden de slots)</small>
                        </h6>
                        <div class="row g-3 mb-2" id="carruselGrid">
                            @for (int pos = 1; pos <= 6; pos++)
                            {
                                var item = carruselItems.FirstOrDefault(c => c.Posicion == pos);
                                var tipo = item?.Tipo ?? "";
                                var idEnSlot = item != null ? (item.ProductoId ?? item.AroId ?? 0) : 0;
                                var token = (item?.Tipo == "Producto" ? "P" : item?.Tipo == "Aro" ? "A" : "") + ":" + idEnSlot;
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="slot-card @(item != null ? "filled" : "empty")" data-pos="@pos" data-token="@token">
                                        <div class="slot-num">#@pos</div>
                                        @if (item != null && item.Tipo == "Producto")
                                        {
                                            var p = item.Producto;
                                            <img src="@ImgProd(p.Id, p.RutaImagen)" alt="" class="slot-thumb" />
                                            <div class="slot-name">@p.Nombre</div>
                                            <div class="slot-badge badge bg-primary-subtle text-primary-emphasis">Producto</div>
                                        }
                                        else if (item != null && item.Tipo == "Aro")
                                        {
                                            var a = item.Aro;
                                            <img src="@ImgAro(a.Id, a.RutaImagen)" alt="" class="slot-thumb" />
                                            <div class="slot-name">@a.Nombre</div>
                                            <div class="slot-badge badge bg-info-subtle text-info-emphasis">Aro</div>
                                        }
                                        else
                                        {
                                            <div class="slot-empty">
                                                <i class="bi bi-plus-circle"></i>
                                                <span>vacío</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-end mb-4">
                            <button type="button" class="btn btn-sm btn-primary" id="btnGuardarCarrusel">
                                <i class="bi bi-save me-1"></i> Guardar carrusel
                            </button>
                            <span class="text-success small ms-2 d-none" id="carruselSaved">
                                <i class="bi bi-check-circle-fill"></i> Guardado
                            </span>
                        </div>

                        <hr />

                        @* ────── DESTACADOS (8 slots fijos) ────── *@
                        <h6 class="mb-3 fw-bold">
                            <i class="bi bi-stars me-1 text-info"></i> Productos Destacados
                            <small class="text-muted fw-normal">(máx 8)</small>
                        </h6>
                        <div class="row g-3 mb-2" id="destacadosGrid">
                            @for (int pos = 1; pos <= 8; pos++)
                            {
                                var item = destacadosItems.FirstOrDefault(d => d.Posicion == pos);
                                var idEnSlot = item != null ? (item.ProductoId ?? item.AroId ?? 0) : 0;
                                var token = (item?.Tipo == "Producto" ? "P" : item?.Tipo == "Aro" ? "A" : "") + ":" + idEnSlot;
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="slot-card @(item != null ? "filled" : "empty")" data-pos="@pos" data-token="@token">
                                        <div class="slot-num">#@pos</div>
                                        @if (item != null && item.Tipo == "Producto")
                                        {
                                            var p = item.Producto;
                                            <img src="@ImgProd(p.Id, p.RutaImagen)" alt="" class="slot-thumb" />
                                            <div class="slot-name">@p.Nombre</div>
                                            <div class="slot-badge badge bg-primary-subtle text-primary-emphasis">Producto</div>
                                        }
                                        else if (item != null && item.Tipo == "Aro")
                                        {
                                            var a = item.Aro;
                                            <img src="@ImgAro(a.Id, a.RutaImagen)" alt="" class="slot-thumb" />
                                            <div class="slot-name">@a.Nombre</div>
                                            <div class="slot-badge badge bg-info-subtle text-info-emphasis">Aro</div>
                                        }
                                        else
                                        {
                                            <div class="slot-empty">
                                                <i class="bi bi-plus-circle"></i>
                                                <span>vacío</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-end mb-4">
                            <button type="button" class="btn btn-sm btn-info" id="btnGuardarDestacados">
                                <i class="bi bi-save me-1"></i> Guardar destacados
                            </button>
                            <span class="text-success small ms-2 d-none" id="destacadosSaved">
                                <i class="bi bi-check-circle-fill"></i> Guardado
                            </span>
                        </div>

                        <hr />

                        @* ────── DISPONIBLES (pool) ────── *@
                        <h6 class="mb-3 fw-bold">
                            <i class="bi bi-inbox me-1 text-success"></i> Disponibles para arrastrar
                            <small class="text-muted fw-normal">(@(dispProductos.Count + dispAros.Count) marcados, fuera de slots)</small>
                        </h6>
                        @if (!dispProductos.Any() && !dispAros.Any())
                        {
                            <div class="alert alert-info py-2">
                                <i class="bi bi-info-circle me-1"></i> No hay items disponibles. Marcá un producto como "Destacado" en la pestaña Productos, o un aro con "Mostrar en landing" en Aros.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 overflow-auto pb-2" id="disponiblesGrid">
                                @foreach (var p in dispProductos)
                                {
                                    <div class="disp-card disp-producto" data-token="P:@p.Id">
                                        @if (!string.IsNullOrEmpty(p.RutaImagen))
                                        {
                                            <img src="@p.RutaImagen" alt="" class="disp-thumb" />
                                        }
                                        <div class="disp-name">@p.Nombre</div>
                                        <span class="badge bg-primary-subtle text-primary-emphasis">Producto</span>
                                    </div>
                                }
                                @foreach (var a in dispAros)
                                {
                                    <div class="disp-card disp-aro" data-token="A:@a.Id">
                                        @if (!string.IsNullOrEmpty(a.RutaImagen))
                                        {
                                            <img src="@a.RutaImagen" alt="" class="disp-thumb" />
                                        }
                                        <div class="disp-name">@a.Nombre</div>
                                        <span class="badge bg-info-subtle text-info-emphasis">Aro</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <style>
                    .slot-card {
                        border: 2px dashed #dee2e6;
                        border-radius: .5rem;
                        padding: .5rem;
                        min-height: 140px;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        text-align: center;
                        position: relative;
                        background: #f8f9fa;
                        transition: all .15s;
                    }
                    .slot-card.filled {
                        border-style: solid;
                        border-color: #3b82f6;
                        background: #fff;
                    }
                    .slot-card.sortable-ghost { opacity: .3; }
                    .slot-card.sortable-chosen { box-shadow: 0 0 0 .25rem rgba(59,130,246,.35); }
                    .slot-num {
                        position: absolute;
                        top: .25rem;
                        left: .5rem;
                        font-size: .75rem;
                        font-weight: 700;
                        color: #6c757d;
                    }
                    .slot-thumb {
                        max-height: 60px;
                        max-width: 100%;
                        object-fit: contain;
                        margin-bottom: .25rem;
                    }
                    .slot-name {
                        font-size: .8rem;
                        font-weight: 600;
                        line-height: 1.1;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        display: -webkit-box;
                        -webkit-line-clamp: 2;
                        -webkit-box-orient: vertical;
                        max-height: 2.2em;
                    }
                    .slot-badge { font-size: .65rem; margin-top: .25rem; }
                    .slot-empty {
                        color: #adb5bd;
                        font-size: .85rem;
                    }
                    .slot-empty i { font-size: 1.5rem; display: block; }

                    .disp-card {
                        border: 1px solid #dee2e6;
                        border-radius: .5rem;
                        padding: .5rem;
                        background: #fff;
                        width: 110px;
                        cursor: grab;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        text-align: center;
                        transition: all .15s;
                    }
                    .disp-card:hover { box-shadow: 0 .25rem .5rem rgba(0,0,0,.1); }
                    .disp-card:active { cursor: grabbing; }
                    .disp-thumb {
                        max-height: 50px;
                        max-width: 100%;
                        object-fit: contain;
                        margin-bottom: .25rem;
                    }
                    .disp-name {
                        font-size: .7rem;
                        font-weight: 600;
                        line-height: 1.1;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        display: -webkit-box;
                        -webkit-line-clamp: 2;
                        -webkit-box-orient: vertical;
                        max-height: 2.2em;
                    }
                    .disp-card .badge { font-size: .6rem; margin-top: .25rem; }
                </style>

                <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
                <script>
                    (function () {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const ANTIFORGERY_HEADER = { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' };

                        // ── Helpers ──
                        function leerOrden(gridId, maxSlots) {
                            const slots = document.querySelectorAll('#' + gridId + ' .slot-card');
                            const orden = [];
                            slots.forEach(s => {
                                const t = s.dataset.token;
                                if (t && t.includes(':') && t.split(':')[1] !== '0') {
                                    orden.push(t);
                                }
                            });
                            return orden.slice(0, maxSlots);
                        }

                        function flashSaved(which) {
                            const el = document.getElementById(which + 'Saved');
                            el.classList.remove('d-none');
                            setTimeout(() => el.classList.add('d-none'), 2500);
                        }

                        function actualizarContador(gridId, counterId, max) {
                            const slots = document.querySelectorAll('#' + gridId + ' .slot-card.filled');
                            document.getElementById(counterId).textContent = slots.length;
                        }

                        // ── SortableJS para CARRUSEL ──
                        new Sortable(document.getElementById('carruselGrid'), {
                            animation: 150,
                            group: { name: 'landing-items', pull: true, put: true },
                            filter: '.col-6, .col-md-4, .col-lg-2', // el slot completo (div col) es draggable
                            draggable: '.col-6, .col-md-4, .col-lg-2',
                            onAdd: function (evt) {
                                // Cuando dropean una .disp-card del pool dentro de un slot-card,
                                // mover el contenido (.disp-card inner) al slot y eliminar el wrapper col.
                                const item = evt.item;
                                const slot = item.querySelector('.slot-card, .disp-card');
                                if (slot && slot.classList.contains('disp-card')) {
                                    // Reemplazar el contenido del slot ocupado por el item del pool
                                    const targetSlot = item.querySelector('.slot-card');
                                    // Limpiar el col wrapper y dejar solo el slot-card
                                }
                            }
                        });

                        // Estrategia más simple: cada slot-card es draggable individualmente.
                        // El pool es un grupo aparte. Los slots del carrusel son 6 fijos.
                        // SortableJS permite arrastrar entre grupos si comparten `group`.

                        // Vamos con la estrategia visual: cada slot-card tiene su contenido.
                        // Los disp-cards también son draggables y se pueden dropear en slots.
                        // Al dropear, el JS intercambia el contenido del slot con el del disp-card.

                        function setupSlot(gridId, counterId, maxSlots, saveUrl, savedId) {
                            const grid = document.getElementById(gridId);

                            // Hacer cada .col que envuelve un slot draggable + droppable
                            Sortable.create(grid, {
                                animation: 150,
                                group: { name: 'landing-' + savedId, pull: true, put: true },
                                draggable: '[data-pos]',
                                filter: '.slot-empty',
                                preventOnFilter: false,
                                onEnd: function () { actualizarContador(gridId, counterId, maxSlots); }
                            });

                            // Hacer cada .disp-card draggable hacia los slots
                            document.querySelectorAll('#disponiblesGrid .disp-card').forEach(card => {
                                Sortable.create(card.parentElement, {
                                    group: { name: 'landing-' + savedId, pull: 'clone', put: false },
                                    draggable: '.disp-card',
                                    sort: false
                                });
                            });

                            document.getElementById('btnGuardar' + (savedId === 'carrusel' ? 'Carrusel' : 'Destacados')).addEventListener('click', async function () {
                                const orden = leerOrden(gridId, maxSlots);
                                const body = new URLSearchParams();
                                orden.forEach(t => body.append('orden', t));

                                try {
                                    const resp = await fetch(saveUrl, {
                                        method: 'POST',
                                        headers: ANTIFORGERY_HEADER,
                                        body: body.toString()
                                    });
                                    const data = await resp.json();
                                    if (data.ok) {
                                        flashSaved(savedId);
                                        actualizarContador(gridId, counterId, maxSlots);
                                    } else {
                                        alert('Error: ' + (data.error || 'desconocido'));
                                    }
                                } catch (e) {
                                    alert('Error de red: ' + e.message);
                                }
                            });
                        }

                        setupSlot('carruselGrid', 'carruselCount', 6,
                                  '@Url.Action("GuardarCarrusel", "Inventory")',
                                  'carrusel');

                        setupSlot('destacadosGrid', 'destacadosCount', 8,
                                  '@Url.Action("GuardarDestacados", "Inventory")',
                                  'destacados');
                    })();
                </script>
            </div>
        }
    </div>
</div>

@section Scripts {
}