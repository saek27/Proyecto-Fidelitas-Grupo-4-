                <style>
                    .list-scroll {
                        max-height: 360px;
                        overflow-y: auto;
                        border: 1px solid #e9ecef;
                        border-radius: .375rem;
                        padding: .5rem;
                        background: #f8f9fa;
                    }
                    .list-item {
                        background: #fff;
                        border: 1px solid #e9ecef;
                        border-radius: .375rem;
                        padding: .375rem .5rem;
                        cursor: pointer;
                        transition: all .15s;
                    }
                    .list-item:hover { box-shadow: 0 .125rem .25rem rgba(0,0,0,.08); border-color: #adb5bd; }
                    .list-item.selected { background: #e7f1ff; border-color: #3b82f6; }
                    .list-thumb {
                        width: 36px;
                        height: 36px;
                        object-fit: contain;
                        border-radius: .25rem;
                    }
                    .list-name {
                        font-size: .85rem;
                        font-weight: 600;
                        line-height: 1.2;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                    }
                    .list-badge { font-size: .65rem; }
                </style>

                <script>
                    (function () {
                        // AJAX para los 2 forms. Tope client-side + fetch + actualización del DOM en vivo.
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                        function leerChecks(form) {
                            const fd = new FormData();
                            form.querySelectorAll('input[name="agregar"]:checked').forEach(cb => fd.append('agregar', cb.value));
                            form.querySelectorAll('input[name="quitar"]:checked').forEach(cb => fd.append('quitar', cb.value));
                            form.querySelectorAll('input[name^="tipo["]').forEach(inp => fd.append(inp.name, inp.value));
                            return fd;
                        }

                        function flashSaved(form) {
                            const span = form.querySelector('[data-saved]');
                            if (!span) return;
                            span.classList.remove('d-none');
                            setTimeout(() => span.classList.add('d-none'), 2500);
                        }

                        async function enviarForm(form, max, label) {
                            const yaSeleccionados = form.querySelectorAll('input[name="quitar"]:checked').length;
                            const yaQuitados = form.querySelectorAll('input[name="quitar"]:not(:checked)').length;
                            const nuevos = form.querySelectorAll('input[name="agregar"]:checked').length;
                            const totalFinal = (yaSeleccionados + yaQuitados + nuevos);

                            // tope: existentes que NO se quitan + nuevos
                            const existentesFinales = form.querySelectorAll('input[name="quitar"]').length
                                - form.querySelectorAll('input[name="quitar"]:checked').length;
                            if (existentesFinales + nuevos > max) {
                                alert(`${label} admite máximo ${max} items. Tenés ${existentesFinales} actuales + ${nuevos} nuevos = ${existentesFinales + nuevos}. Quité ${(existentesFinales + nuevos) - max} primero.`);
                                return;
                            }
                            if (existentesFinales + nuevos === 0 && max > 0) {
                                alert(`${label} no puede quedar vacío. Mantené al menos uno o desmarcá todo desde Productos/Aros.`);
                                return;
                            }

                            const btn = form.querySelector('button[type="submit"]');
                            const originalText = btn.innerHTML;
                            btn.disabled = true;
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

                            try {
                                const resp = await fetch(form.action, {
                                    method: 'POST',
                                    headers: { 'RequestVerificationToken': token },
                                    body: leerChecks(form)
                                });
                                const data = await resp.json();
                                if (data.ok) {
                                    flashSaved(form);
                                    // Recargar la página para reflejar el nuevo estado del pool/slot
                                    // (necesario porque la membresía cambia y la paginación puede cambiar)
                                    window.location.reload();
                                } else {
                                    alert('Error: ' + (data.error || 'desconocido'));
                                    btn.disabled = false;
                                    btn.innerHTML = originalText;
                                }
                            } catch (e) {
                                alert('Error de red: ' + e.message);
                                btn.disabled = false;
                                btn.innerHTML = originalText;
                            }
                        }

                        const formCarrusel = document.getElementById('formLandingCarrusel');
                        if (formCarrusel) {
                            formCarrusel.addEventListener('submit', function (e) {
                                e.preventDefault();
                                enviarForm(this, 6, 'El carrusel');
                            });
                        }
                        const formDestacados = document.getElementById('formLandingDestacados');
                        if (formDestacados) {
                            formDestacados.addEventListener('submit', function (e) {
                                e.preventDefault();
                                enviarForm(this, 8, 'Destacados');
                            });
                        }
                    })();
                </script>
            </div>
        }
    </div>
</div>

