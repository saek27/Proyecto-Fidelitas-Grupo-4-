@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = Model.Nombre;
}
@model OC.Core.Domain.Entities.Aro
@{
    var imagenes = ViewBag.Imagenes as List<OC.Core.Domain.Entities.AroImagen>
                   ?? new List<OC.Core.Domain.Entities.AroImagen>();
    var carouselId = "carouselAro" + Model.Id;
    var defaultImg = "/images/default-product.jpg";
}

<div class="container my-5 pt-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-3 animate-on-scroll mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-3 animate-on-scroll mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="row g-5 align-items-start animate-on-scroll">

        <!-- ============ CARRUSEL DE IMÁGENES ============ -->
        <div class="col-12 col-lg-6">
            <div class="card card-premium border-0 shadow-lg p-3 position-relative overflow-hidden" style="border-radius: 20px;">

                @if (imagenes.Count > 1)
                {
                    <div id="@carouselId" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
                        <!-- Indicators -->
                        <div class="carousel-indicators" style="bottom: 12px; margin-bottom: 0;">
                            @for (int i = 0; i < imagenes.Count; i++)
                            {
                                <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "") @(imagenes[i].EsPrincipal ? "indicador-principal" : "")"
                                        aria-current="@(i == 0 ? "true" : "false")"
                                        aria-label="Slide @(i + 1)"></button>
                            }
                        </div>

                        <!-- Slides -->
                        <div class="carousel-inner rounded" style="overflow: hidden; background: rgba(15, 23, 42, 0.4);">
                            @for (int i = 0; i < imagenes.Count; i++)
                            {
                                var img = imagenes[i];
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <div class="d-flex align-items-center justify-content-center"
                                         style="aspect-ratio: 1 / 1; width: 100%;">
                                        <img src="@(string.IsNullOrEmpty(img.Ruta) ? defaultImg : img.Ruta)"
                                             class="img-fluid"
                                             alt="@Model.Nombre"
                                             style="max-height: 100%; max-width: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.4));"
                                             onerror="this.onerror=null; this.src='@defaultImg';" />
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Controles -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    </div>
                }
                else
                {
                    <!-- Imagen única (sin carrusel) -->
                    <div class="d-flex align-items-center justify-content-center"
                         style="aspect-ratio: 1 / 1; width: 100%; background: rgba(15, 23, 42, 0.4); border-radius: 12px;">
                        <img src="@(string.IsNullOrEmpty(Model.RutaImagen) ? defaultImg : (imagenes.FirstOrDefault()?.Ruta ?? Model.RutaImagen))"
                             class="img-fluid"
                             alt="@Model.Nombre"
                             style="max-height: 100%; max-width: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.4)); transition: transform 0.5s ease;"
                             onmouseover="this.style.transform='scale(1.05)'"
                             onmouseout="this.style.transform='scale(1)'"
                             onerror="this.onerror=null; this.src='@defaultImg';" />
                    </div>
                }

                <!-- ============ THUMBNAILS (solo si hay más de 1 imagen) ============ -->
                @if (imagenes.Count > 1)
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3 pt-3" style="border-top: 1px solid var(--glass-border);">
                        @for (int i = 0; i < imagenes.Count; i++)
                        {
                            var img = imagenes[i];
                            <button type="button" class="p-0 border-0 bg-transparent thumbnail-btn @(i == 0 ? "active" : "")"
                                    data-bs-target="#@carouselId" data-bs-slide-to="@i"
                                    style="width: 64px; height: 64px; cursor: pointer; border-radius: 8px; overflow: hidden; outline: @(i == 0 ? "2px solid var(--brand-accent)" : "2px solid transparent"); outline-offset: 2px; transition: outline 0.2s, transform 0.15s;"
                                    onmouseover="if(!this.classList.contains('active')) this.style.outline='2px solid rgba(255,255,255,0.3)'; this.style.transform='scale(1.05)';"
                                    onmouseout="if(!this.classList.contains('active')) this.style.outline='2px solid transparent'; this.style.transform='scale(1)';">
                                <img src="@(string.IsNullOrEmpty(img.Ruta) ? defaultImg : img.Ruta)"
                                     alt="Miniatura @(i + 1)"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='@defaultImg';" />
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ============ INFO DEL ARO ============ -->
        <div class="col-12 col-lg-6">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/landing/catalogo" class="text-primary text-decoration-none hover-primary transition">Catálogo</a></li>
                    <li class="breadcrumb-item"><a href="/landing/catalogo?categoria=Lentes Graduados" class="text-primary text-decoration-none hover-primary transition">Lentes Graduados</a></li>
                    <li class="breadcrumb-item active text-light opacity-50" aria-current="page">Detalles del aro</li>
                </ol>
            </nav>

            <h1 class="display-4 fw-bold text-white mb-2" style="line-height: 1.1;">@Model.Nombre</h1>
            <p class="text-light opacity-50 small mb-4 tracking-wide">SKU: @Model.SKU</p>

            <p class="display-5 fw-bold mb-4" style="color: var(--brand-accent);">₡@Model.Precio.ToString("N2")</p>

            <div class="mb-4">
                @if (Model.Stock > 0)
                {
                    <span class="badge rounded-pill px-3 py-2 fw-normal shadow-sm" style="background: rgba(25, 135, 84, 0.2); border: 1px solid rgba(25, 135, 84, 0.5); color: #86efac;">
                        <i class="bi bi-check2-circle me-1"></i> Stock disponible: @Model.Stock unidades
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill px-3 py-2 fw-normal shadow-sm" style="background: rgba(220, 53, 69, 0.2); border: 1px solid rgba(220, 53, 69, 0.5); color: #fca5a5;">
                        <i class="bi bi-x-circle me-1"></i> Producto agotado
                    </span>
                }
            </div>

            <div class="alert alert-info border-0 shadow-sm animate-on-scroll" role="alert" style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3) !important; color: #93c5fd;">
                <i class="bi bi-info-circle me-2"></i>
                <strong>¿Cómo comprar este aro?</strong> Los aros se venden a través de nuestro personal en la óptica. Acércate a tu sucursal más cercana con tu receta médica actualizada y te ayudamos a completar la compra con los lentes ideales para ti.
            </div>

            <hr class="border-secondary mb-4 mt-2">

            <div class="mt-4 pt-3">
                <a href="/landing/catalogo?categoria=Lentes Graduados" class="btn btn-outline-light px-4 py-2 text-light opacity-75 hover-opacity-100 transition d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-2"></i> Volver a Lentes Graduados
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    .thumbnail-btn.active {
        outline: 2px solid var(--brand-accent) !important;
    }
    .carousel-indicators button.indicador-principal {
        background-color: var(--brand-accent);
    }
    .carousel-control-prev, .carousel-control-next {
        width: 8%;
    }
    .carousel-control-prev-icon, .carousel-control-next-icon {
        filter: drop-shadow(0 0 4px rgba(0,0,0,0.5));
    }
</style>
