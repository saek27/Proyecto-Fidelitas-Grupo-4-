@using OC.Core.Domain.Entities
@using OC.Core.Domain.Enums
@model OC.Core.Common.PagedResult<Venta>

@{
    ViewData["Title"] = "Ventas";

    var pagination = new PaginationInfo
    {
        CurrentPage = Model.PageIndex,
        TotalPages = Model.TotalPages,
        GetPageUrl = (page) => Url.Action("Index", new
        {
            page,
            search = ViewBag.Search,
            metodo = ViewBag.Metodo,
            desde = ViewBag.Desde,
            hasta = ViewBag.Hasta,
            sort = ViewBag.Sort
        })!
    };
}

<div class="container-fluid px-4">
    <div class="page-header animate-fade-up">
        <div class="page-header-text">
            <div class="page-header-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <h1 class="page-title">Ventas</h1>
                <p class="page-subtitle">
                    <i class="bi bi-info-circle me-1"></i>
                    @(Model.TotalCount == 0 ? "Sin ventas registradas." : $"{Model.TotalCount} venta(s).")
                </p>
            </div>
        </div>
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-brand">
                <i class="bi bi-plus-circle me-2"></i> Nueva venta
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show animate-fade-up mb-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show animate-fade-up mb-3" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card-dashboard animate-fade-up delay-1 mb-3">
        <div class="card-body filter-bar">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="search">Paciente, cajero o factura</label>
                    <input type="text" name="search" id="search" class="form-control form-control-sm"
                           value="@ViewBag.Search" placeholder="Nombre, cédula, FAC-...">
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="metodo">Método de pago</label>
                    <select name="metodo" id="metodo" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        <option value="Efectivo" selected="@(ViewBag.Metodo == "Efectivo")">Efectivo</option>
                        <option value="SINPE" selected="@(ViewBag.Metodo == "SINPE")">SINPE</option>
                        <option value="Tarjeta" selected="@(ViewBag.Metodo == "Tarjeta")">Tarjeta</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="desde">Desde</label>
                    <input type="date" name="desde" id="desde" class="form-control form-control-sm" value="@ViewBag.Desde">
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="hasta">Hasta</label>
                    <input type="date" name="hasta" id="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta">
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="sort">Ordenar por total</label>
                    <select name="sort" id="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Fecha (nuevas)</option>
                        <option value="asc" selected="@(ViewBag.Sort == "asc")">Total Menor → Mayor</option>
                        <option value="desc" selected="@(ViewBag.Sort == "desc")">Total Mayor → Menor</option>
                    </select>
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-brand btn-sm flex-fill" title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search)
                         || !string.IsNullOrWhiteSpace((string?)ViewBag.Metodo)
                         || !string.IsNullOrWhiteSpace((string?)ViewBag.Desde)
                         || !string.IsNullOrWhiteSpace((string?)ViewBag.Hasta)
                         || !string.IsNullOrWhiteSpace((string?)ViewBag.Sort))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpiar">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card-dashboard animate-fade-up delay-2">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaVentas">
                    <thead class="table-light">
                        <tr>
                            <th style="width:120px">Factura</th>
                            <th>Fecha</th>
                            <th>Paciente</th>
                            <th>Cajero</th>
                            <th>Método</th>
                            <th class="text-end" style="width:140px">Total</th>
                            <th class="text-center" style="width:80px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">@v.NumeroFactura</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@v.FechaVenta.ToString("dd/MM/yyyy")</span>
                                        <span class="text-muted small">@v.FechaVenta.ToString("HH:mm")</span>
                                    </div>
                                </td>
                                <td>@v.Paciente?.NombreCompleto</td>
                                <td>@v.Usuario?.Nombre</td>
                                <td>
                                    <span class="status-badge" style="background:rgba(59,130,246,.10);color:#1d4ed8;">
                                        <i class="bi bi-credit-card"></i> @v.MetodoPago
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">@($"₡{v.Total:N0}")</td>
                                <td class="text-center">
                                    <a asp-action="Factura" asp-route-id="@v.Id"
                                       class="btn-action btn-action-info" title="Ver factura">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="bi bi-search"></i></div>
                    <h5 class="empty-state-title">No hay ventas que coincidan</h5>
                    <p class="empty-state-text">Ajusta los filtros o limpia la búsqueda para ver todas las ventas.</p>
                </div>
            }
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", pagination)
</div>
